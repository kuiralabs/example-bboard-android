<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Declare visibility to Kuira wallet for cross-app binding -->
    <queries>
        <package android:name="com.midnight.kuira" />
        <intent>
            <action android:name="com.midnight.kuira.CONNECTOR" />
        </intent>
    </queries>

    <application
        android:name=".BBoardApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".BBoardActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    
        <!-- Blockfrost project id for PreProd. PreProd's own indexer was decommissioned on
             2026-10-09 and the replacement authenticates on every request, so without this
             PreProd reads nothing. The value comes from this app's local.properties
             (kuira.blockfrost.projectId), supplied as a placeholder by the Kuira contract
             plugin, so the credential stays out of version control. Empty when unset, which
             reads as "not configured" — only PreProd objects. -->
        <meta-data
            android:name="io.github.kuiralabs.BLOCKFROST_PROJECT_ID"
            android:value="${blockfrostProjectId}" />

        <!-- Dev-seed escape hatch. When this app's local.properties sets kuira.dev.seed, the
             SDK skips the passkey ceremony and uses that 64-byte seed, so an automated run can
             reach a known funded wallet. The SDK ignores it unless THIS app is debuggable, and
             the value never enters the published SDK — it is this app's to supply. -->
        <meta-data
            android:name="io.github.kuiralabs.DEV_SEED"
            android:value="${kuiraDevSeed}" />
    </application>
</manifest>
